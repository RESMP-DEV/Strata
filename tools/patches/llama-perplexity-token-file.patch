+static std::string g_token_file;
+
+static bool read_token_file(const std::string & file_name, const llama_vocab * vocab,
+                            std::vector<llama_token> & tokens) {
+    std::ifstream input(file_name, std::ios::binary);
+    if (!input) {
+        LOG_ERR("%s: failed to open token file %s\n", __func__, file_name.c_str());
+        return false;
+    }
+    input.seekg(0, std::ios::end);
+    const std::streamoff size = input.tellg();
+    if (size < 0 || size % sizeof(int32_t) != 0) {
+        LOG_ERR("%s: token file %s must contain whole int32 values\n", __func__, file_name.c_str());
+        return false;
+    }
+    input.seekg(0, std::ios::beg);
+    tokens.resize(static_cast<size_t>(size) / sizeof(int32_t));
+    input.read(reinterpret_cast<char *>(tokens.data()), static_cast<std::streamsize>(size));
+    if (!input) {
+        LOG_ERR("%s: failed to read token file %s\n", __func__, file_name.c_str());
+        return false;
+    }
+    const int32_t n_vocab = llama_vocab_n_tokens(vocab);
+    for (size_t i = 0; i < tokens.size(); ++i) {
+        if (tokens[i] < 0 || tokens[i] >= n_vocab) {
+            LOG_ERR("%s: token id %d at offset %zu is outside the vocabulary\n", __func__, tokens[i], i);
+            return false;
+        }
+    }
+    LOG_INF("%s: loaded %zu exact token ids from %s\n", __func__, tokens.size(), file_name.c_str());
+    return true;
+}
+
+static bool prepare_tokens(llama_context * ctx, const common_params & params, std::vector<llama_token> & tokens) {
+    if (!g_token_file.empty()) {
+        const llama_model * model = llama_get_model(ctx);
+        const llama_vocab * vocab = llama_model_get_vocab(model);
+        return read_token_file(g_token_file, vocab, tokens);
+    }
+    tokens = common_tokenize(ctx, params.prompt, true);
+    return true;
+}
+
